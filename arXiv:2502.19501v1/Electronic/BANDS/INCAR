# System and LoT
# --------------
SYSTEM = La3Ni2O7                       # Title of the SYSTEM
GGA = PE                                # Generalized Gradient Approximation functional

# Electronic Structure
# --------------------
ISMEAR = 0                              # Gaussian smearing
SIGMA = 0.04                            # Width of the smearing in eV
ISPIN = 1                               # Non-Spin polarized DFT
EDIFF = 1E-08                           # SCF energy convergence threshold (in eV)
ENCUT = 600.0                           # Plane-wave energy cutoff (eV)
NBANDS = 224                            # Total number of KS orbitals
LWAVE = .FALSE.                         # do not overwrite WAVECAR
LCHARG = .FALSE.                        # do not overwrite CHGCAR
ICHARG = 11                             # use CHGCAR file for interpolation
LORBIT = 11                             # compute lm-decomposed states
EMIN = -40 ; EMAX = 40                  # smallest/largest energy included in calculation
NEDOS = 1000                            # sampling points for DOS
