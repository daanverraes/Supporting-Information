LDAUL     = 3 -1 -1             # U on Ni d only
LDAUU     = 18.00 0.00 0.00     # U values (eV)
LDAUJ     = 0.00 0.00 0.00      # J values (eV)
LMAXMIX   = 6                   # Charge mixing limit
LDAUPRINT = 1                   # Minimal DFT+U output
