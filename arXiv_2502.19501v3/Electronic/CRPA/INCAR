
SYSTEM = La3Ni2O7                   #  System name
ISMEAR = 0                          #  Gaussian smearing
SIGMA  = 0.04                       #  Smearing width (eV)
EDIFF  = 1E-08                      #  SCF convergence
ENCUT  = 600.0                      #  Plane-wave cutoff (eV)
NBANDS = 336                        #  Number of bands

NCSHMEM = 1                         #  Disable shared memory
ALGO = CRPA                         #  Enable cRPA
PRECFOCK = Fast                     #  Fast FFT mode
NTARGET_STATES = 1 2 3 4 5 6 7 8    #  Target states

LDAU      = .TRUE.                  #  Enable DFT+U
LDAUTYPE  = 2                       #  Dudarev scheme
LDAUL     = 3 -1 -1                 #  U on Ni d only
LDAUU     = 18.00 0.00 0.00         #  U values (eV)
LDAUJ     = 0.00 0.00 0.00          #  J values (eV)
LMAXMIX   = 6                       #  Charge mixing limit
LDAUPRINT = 1                       #  Minimal DFT+U output
